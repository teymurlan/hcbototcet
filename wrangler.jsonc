{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tarot-photo-bot",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-26",
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
