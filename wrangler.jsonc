{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hcbototcet",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-04",
  "observability": { "enabled": true },
  "triggers": { "crons": ["*/15 * * * *"] },
  "durable_objects": {
    "bindings": [
      { "name": "STATE", "class_name": "AppState" },
      { "name": "BOOKING_STORE", "class_name": "AppStore", "script_name": "bugalter3" }
    ]
  },
  "migrations": [
    { "tag": "v5", "new_sqlite_classes": ["AppState"] }
  ]
}
